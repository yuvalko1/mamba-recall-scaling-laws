{
  runtime: {
    seed: 0,
    should_train: true,
    device: null,
  },
  seeds: {
    n_seeds: 3,
    start_seed: 0,
  },
  model: {
    "class": "mamba_tiny",
    variant: "simplified",
    args: {
      vocab_size: null,
      d_model: null,
      d_state: null,
      expand: 2,
      d_conv: 2,
      n_layers: null,
      bias: false,
      conv_bias: false,
      scan_mode: "cumsum",
    },
    kwargs: {
      skip_normalizations: true,
      skip_non_linearities: true,
      skip_gating: true,
      skip_biases: true,
      skip_discretization: true,
      skip_residual_connection: true,
      ssm_mode: "attention",
      compute_attention: true,
      freeze_initialized_weights: true,
      init_A: 1,
      init_D: 0,
      set_designed_mqar_weights: false,
      head_pattern: "MVA",
    },
  },
  dataset: {
    kwargs: {
      power_a: 1.0,
      random_non_queries: true,
      reduce_to_AR: false,
      num_key_repeats: 1,
      num_query_repeats: 1,
    },
    batch_size: 128,
    split_size: {
      val: 10000,
      test: 10000,
    },
  },
  training: {
    optimizer: {
      learning_rate: 0.01,
      betas: [
        0.9,
        0.95,
      ],
      weight_decay: 0.0,
    },
    scheduler: {
        num_warmup_steps: 100,
        num_steps_at_max: 1400,
      decay_type: "cosine",
      num_decay_steps: 2500,
      decay_factor: 0.0,
    },
    label_smoothing: 0.1,
    clip_grad: true,
    clip_grad_max_norm: 5,
    grad_accum_steps: 1,
    use_amp: false,
    max_num_steps: 4000,
    evaluate_any_num_steps: 1000,
    threshold_accuracy: 1,
    save_logs_any_num_steps: 100,
    save_model_at_evaluation: false,
    save_model_checkpoints: false,
    view_train_tqdm: true,
    view_evaluation_tqdm: false,
    print_non_tqdm_debug_messages: false,
    view_per_gridpoint_tqdm: false,
  },
  parallel: {
    devices_to_use: null,
    num_processes_per_device: 12,
    num_cpu_threads_per_process: 1,
  },
  wandb: {
    activate: true,
    accuracy_grid_plots: {
      activate: true,
    },
    verbose: false,
    log_val: false,
  },
  grid_options: {
    shuffle: true,
  },
  grid: {
    V: 512,
    N_facts: 16, L: 64,
    D: 60,
    N: "np.arange(2, 10+1, step=1)",
    Lambda: 1,
    M: "np.arange(1, 6+1, step=1)",
    x_axis: "N",
    y_axis: "M"
  },
