{
  runtime: {
    seed: 0,
    should_train: true,
    device: null,
  },
  seeds: {
    n_seeds: 1,
    start_seed: 0,
  },
  model: {
    "class": "mamba_tiny",
    variant: "simplified",
    args: {
      vocab_size: null,
      d_model: null,
      d_state: null,
      expand: 2,
      d_conv: 2,
      n_layers: null,
      bias: false,
      conv_bias: false,
      scan_mode: "cumsum",
    },
    kwargs: {
      skip_normalizations: true,
      skip_non_linearities: true,
      skip_gating: true,
      skip_biases: true,
      skip_discretization: true,
      skip_residual_connection: true,
      ssm_mode: "attention",
      compute_attention: true,
      freeze_initialized_weights: true,
      init_A: 1,
      init_D: 0,
      set_designed_mqar_weights: false,
    },
  },
  dataset: {
    kwargs: {
      power_a: 1.0,
      random_non_queries: true,
      reduce_to_AR: false,
      num_key_repeats: 1,
      num_query_repeats: 1,
    },
    batch_size: 5,
    split_size: {
      val: 10000,
      test: 10000,
    },
  },
  training: {
    optimizer: {
      learning_rate: 3e-3,
      betas: [
        0.9,
        0.95,
      ],
      weight_decay: 0.0,
    },
    scheduler: {
      num_warmup_steps: 500,
      num_steps_at_max: 3500,
      decay_type: "cosine",
      num_decay_steps: 8000,
      decay_factor: 0.0,
    },
    label_smoothing: 0.1,
    clip_grad: true,
    clip_grad_max_norm: 2.5,
    grad_accum_steps: 4,
    use_amp: false,
    max_num_steps: 12000,
    evaluate_any_num_steps: 2500,
    threshold_accuracy: 0.999,
    save_logs_any_num_steps: 250,
    save_model_at_evaluation: false,
    view_train_tqdm: true,
    view_evaluation_tqdm: false,
    print_non_tqdm_debug_messages: false,
    view_per_gridpoint_tqdm: false,
  },
  parallel: {
    devices_to_use: null,
    num_processes_per_device: 16,
    num_cpu_threads_per_process: 1,
  },
  wandb: {
    activate: true,
    accuracy_grid_plots: {
      activate: true,
    },
    verbose: false,
    log_val: false,
  },
  grid_options: {
    shuffle: false,
  },
  grid: {
    V: "np.logspace(start=3, stop=np.log10(5e4), num=10)[::-1] // 2 * 2 + 2",
    L: "np.array([1000, 2000, 3000, 4000])[::-1]",
    N_facts: null,
    scale_Nf_with_L: true,
    D: 150,
    N: 75,
    Lambda: 1,
    M: 1,
  	x_axis: "V",
  	y_axis: "L"
  }
}