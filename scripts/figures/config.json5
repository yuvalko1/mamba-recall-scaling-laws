{
  // Drives the generic figure makers. Each `grids` entry maps a saved_runs_data/
  // bundle (root: 'results' plots a local run) to:
  //   make_grid_figures.py           -> figures/<name>.png
  //   make_scaling_curve_figures.py  -> figures/<name>__acc_curve__sigma_inv.png
  // Entries may override `defaults`; opt out with grid_figure/curve_figure: false.

  defaults: {
    root: 'saved_runs_data',
    split: 'val',
    seed_aggregation: 'max',
    show_title: false,
    show_text: false,
    show_cbar: false,
    figsize: [7, 5],
    cmap: 'inferno',
    // paper-PNG format: italic math axis labels + endpoint-anchored quarter ticks
    math_labels: true,
    ticks_type: 'quarter',
  },

  // mech-interp figures (make_mech_interp_figures.py): Fig 3 + the reversing appendix figures.
  mech_interp: {
    run: 'MQAR__D_N__linear_trained__mech_interp/mamba_tiny_simplified__D_N_V256_L64_Nf16_Lambda1_M1__29_08_2026__18_31_41',
    cells: [
      { D: 64, N: 32, seed: 13 }, // paper body (Fig 3)
      { D: 48, N: 32, seed: 26 },
      { D: 64, N: 24, seed: 14 },
    ],
    plot_kwargs: {
      cmap: 'inferno', vmin: 0, vmax: null,
      no_title: true, no_cbar: true, save: true
    },
  },

  grids: {
    MQAR__D_N__linear_trained__regime_0: {
      curve_subdir: 'appendix',
      run: 'MQAR__D_N__linear_trained__regime_0/mamba_tiny_simplified__D_N_V512_L64_Nf16_Lambda1_M1__28_08_2026__19_57_27',
    },
    MQAR__D_N__linear_trained__regime_1: {
      grid_subdir: 'appendix', curve_subdir: 'appendix',
      run: 'MQAR__D_N__linear_trained__regime_1/mamba_tiny_simplified__D_N_V512_L128_Nf32_Lambda1_M1__28_08_2026__19_57_28',
    },
    MQAR__D_N__linear_trained__regime_2: {
      run: 'MQAR__D_N__linear_trained__regime_2/mamba_tiny_simplified__D_N_V1024_L64_Nf16_Lambda1_M1__28_08_2026__19_57_28',
    },

    // full-model (mamba_ssm) grids
    MQAR__D_N__full_trained__regime_0: {
      curve_subdir: 'appendix',
      run: 'MQAR__D_N__full_trained__regime_0/mamba_ssm_full__D_N_V512_L64_Nf16_Lambda1_M1__28_08_2026__18_45_36',
    },
    MQAR__D_N__full_trained__regime_1: {
      grid_subdir: 'appendix', curve_subdir: 'appendix',
      run: 'MQAR__D_N__full_trained__regime_1/mamba_ssm_full__D_N_V512_L128_Nf32_Lambda1_M1__28_08_2026__18_45_36',
    },
    MQAR__D_N__full_trained__regime_2: {
      run: 'MQAR__D_N__full_trained__regime_2/mamba_ssm_full__D_N_V1024_L64_Nf16_Lambda1_M1__28_08_2026__18_45_36',
    },

    // derived approximate-theory panels (theory_approx): the paper's '...__acc_grid__theoretical'
    // format - closed-form sigma^2 = a*N_f/(ND) + 1/D, Phi(1/sigma - m_V); computed from the
    // referenced trained bundle's axes/constants, no run involved. regime_2 is the Fig. 1 panel
    MQAR__D_N__linear_trained__regime_0__theoretical: {
      grid_subdir: 'appendix',
      run: 'MQAR__D_N__linear_trained__regime_0/mamba_tiny_simplified__D_N_V512_L64_Nf16_Lambda1_M1__28_08_2026__19_57_27',
